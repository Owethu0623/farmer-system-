# GEMINI_API_KEY: Required for server-side Gemini AI agricultural advisory calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used to sign session tokens.
SESSION_SECRET="change-this-to-a-strong-random-secret"

# PostgreSQL + PostGIS configuration (optional; defaults to persistent server-side relational store if unset)
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="field_shift"
PGUSER="field_shift_app"
PGPASSWORD="change-this-db-password"

# Server-side relational store path when running standalone without external Postgres
DATA_FILE_PATH="./data/fieldshift-db.json"

# Optional South African Weather Service (SAWS) & DALRRD geospatial feed endpoints
SAWS_API_URL=""
SAWS_API_KEY=""
DALRRD_SOIL_WFS_URL=""

